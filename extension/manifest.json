{
  "manifest_version": 3,
  "name": "Nexte Agente 1 — GMaps Leads Scraper",
  "description": "Scrapea Google Maps con memoria de zonas GPS (Agente 1) y envía leads al CRM Nexte",
  "version": "2.0.0",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.google.com/maps/*",
    "https://*.google.com.ar/maps/*",
    "http://localhost:3001/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://*.google.com/maps/*",
        "https://*.google.com.ar/maps/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GMaps Scraper"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "web_accessible_resources": [
    {
      "resources": ["notification.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}
